# HotelPro Environment Configuration Template
# Set NODE_ENV to production in Render backend service
NODE_ENV=development
PORT=5000

# Client Frontend URLs (Allowed Origins for CORS)
# Production: https://hotelpro-1frontend.onrender.com
# Local development: http://localhost:5173
CLIENT_URL=http://localhost:5173

# MongoDB Connection Configuration
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro
# MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hotelpro?retryWrites=true&w=majority
# Legacy alias support:
# MONGODB_CONNECTION_LINK=

# Set to true only if running standalone API testing without a database server
ALLOW_OFFLINE_STANDALONE=false

# Authentication Secrets
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional Email (SMTP / Nodemailer)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Media Storage (Cloudinary / S3)
CLOUD_STORAGE_NAME=
CLOUD_STORAGE_API_KEY=
CLOUD_STORAGE_API_SECRET=
